# F15: systemd service for money-room engine
# Install: sudo cp money-room.service /etc/systemd/system/
# Enable:  sudo systemctl enable money-room
# Start:   sudo systemctl start money-room
# Status:  sudo systemctl status money-room
# Logs:    journalctl -u money-room -f

[Unit]
Description=Money Room Trading Engine
After=network.target
Wants=network.target

[Service]
Type=simple
User=moneyroom
Group=moneyroom
WorkingDirectory=/home/wubu2/money-room
ExecStart=/home/wubu2/money-room/engine/room_engine
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=30
TimeoutStopSec=60

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/wubu2/money-room /home/wubu2/.hermes
PrivateTmp=true

# Environment
Environment=ROOM_DIR=/home/wubu2/money-room
Environment=STATE_PATH=/home/wubu2/money-room/data/room_state.bin

# Resource limits
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
