{
    "policy": "D54: Data retention policy",
    "version": 1,
    "rules": [
        {
            "pattern": "btc_1min_latest.csv",
            "keep": "1 year",
            "action": "compress_after_30d",
            "priority": "high"
        },
        {
            "pattern": "*.csv",
            "keep": "2 years",
            "action": "compress_after_90d",
            "priority": "medium"
        },
        {
            "pattern": "*.json",
            "keep": "1 year",
            "action": "delete_after_retention",
            "priority": "medium"
        },
        {
            "pattern": "*.tar.gz",
            "keep": "1 year",
            "action": "delete_after_retention",
            "priority": "low"
        },
        {
            "pattern": "room_state.bin",
            "keep": "forever",
            "action": "never_delete",
            "priority": "critical"
        },
        {
            "pattern": "timeline.db",
            "keep": "forever",
            "action": "never_delete",
            "priority": "critical"
        },
        {
            "pattern": "training_data.bin",
            "keep": "forever",
            "action": "never_delete",
            "priority": "high"
        },
        {
            "pattern": "*.log",
            "keep": "30 days",
            "action": "rotate_and_delete",
            "priority": "low"
        }
    ],
    "enforcement": "scripts/data_archive.sh runs monthly via cron",
    "review": "Policy reviewed when storage exceeds 80% capacity"
}
