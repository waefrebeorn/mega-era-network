# Logrotate config for Money Room logs
# Install: sudo cp /home/wubu2/.hermes/logrotate-money-room /etc/logrotate.d/money-room

/home/wubu2/.hermes/pm_logs/c_room/*.csv {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 100M
}

/home/wubu2/.hermes/pm_logs/c_room/*.jsonl {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 500M
}

/home/wubu2/.hermes/pm_logs/room_log.csv {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    maxsize 50M
}
